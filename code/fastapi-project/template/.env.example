# Copy to .env and fill in real values for local development.
# .env is gitignored; .env.example is committed and documents the contract.

APP_NAME=myapi
APP_VERSION=0.0.1
DEBUG=true

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-a-random-secret

# SQLAlchemy URL. Examples:
#   SQLite:   sqlite:///./local.db
#   Postgres: postgresql+psycopg://user:password@localhost:5432/myapi
DATABASE_URL=sqlite:///./local.db

# Comma-separated list of CORS origins, or leave empty for none.
CORS_ORIGINS=http://localhost:5173
