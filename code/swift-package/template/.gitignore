# Swift Package Manager build output
.build/
DerivedData/

# IDE state — generated by Xcode when opening Package.swift directly.
.swiftpm/

# Xcode user state
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcscheme

# Package.resolved policy:
#
#   - For *applications* (CLIs, iOS apps), commit Package.resolved so
#     installs are reproducible across machines.
#   - For *libraries* published to consumers, do NOT commit it — let
#     downstream resolutions take priority.
#
# This template is library + executable; the safe default is to
# commit it (so the executable's deps are pinned). Uncomment the
# next line if you decide to publish as a pure library and want
# downstreams to resolve freshly.
# Package.resolved

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*~
