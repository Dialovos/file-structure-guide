<Project>
  <!--
    Repo-wide MSBuild settings. Imported automatically by every .csproj
    in the tree before any targets run. Per-project overrides still
    work; they apply on top.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Make every project self-document via README in its dir, if present. -->
    <None Include="README.md" Condition="Exists('README.md')" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
