<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Console app sharing Core. Uses System.CommandLine for arg parsing;
    the version is pinned in /Directory.Packages.props.
  -->
  <PropertyGroup>
    <RootNamespace>MySolution.Cli</RootNamespace>
    <AssemblyName>MySolution.Cli</AssemblyName>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MySolution.Core\MySolution.Core.csproj" />
  </ItemGroup>
</Project>
