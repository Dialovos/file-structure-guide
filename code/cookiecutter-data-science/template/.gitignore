# --- Data ---
# Track the directories with .gitkeep, ignore everything else inside them.
data/raw/*
data/interim/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# --- Models ---
models/*
!models/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Environments ---
.venv/
venv/
env/
.env
.envrc

# --- Notebooks ---
.ipynb_checkpoints/

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
