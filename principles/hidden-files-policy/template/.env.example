# .env.example — hidden but COMMITTED. The discoverable-template pattern.
#
# Why hidden: this is tool plumbing in the dotfile family (.env*).
# Why committed: contributors need to know which environment variables
# the application expects. Without a checked-in template, every new
# contributor would have to read the source to figure out what to set.
#
# Workflow:
#   1. Copy this file to `.env` (gitignored).
#   2. Fill in real values locally.
#   3. Never commit the populated `.env`.
#
# The values below are placeholders, not secrets. Keep it that way.

# --- App ---------------------------------------------------------------
APP_ENV=development
APP_PORT=3000
APP_LOG_LEVEL=info

# --- Database ----------------------------------------------------------
DATABASE_URL=postgres://user:password@localhost:5432/myapp

# --- External APIs (placeholders only — no real keys) ------------------
STRIPE_API_KEY=sk_test_REPLACE_ME
SENDGRID_API_KEY=SG.REPLACE_ME

# --- Feature flags -----------------------------------------------------
FEATURE_NEW_CHECKOUT=false
