# .gitignore — generated-vs-source-separation template.
#
# Every entry below names something a build step or package manager
# *produces*. Tracking any of them would mix authored source with
# regeneratable output — exactly what this policy forbids.
#
# Notice: in a real project, dist/.gitkeep would be removed and dist/
# itself would be ignored cleanly. The .gitkeep is only here so the
# template's layout ships visibly.

# --- JavaScript / TypeScript build outputs -----------------------------
dist/
build/
out/
.next/
.nuxt/
.turbo/
.parcel-cache/

# --- Dependencies (regenerated by `npm install` / `pnpm install`) ------
node_modules/

# --- Rust build outputs ------------------------------------------------
target/

# --- Java / Maven / Gradle ---------------------------------------------
# Maven uses target/ (already listed); Gradle uses build/ (already listed).

# --- Static site generators --------------------------------------------
_site/             # Jekyll, Eleventy
public/            # Hugo, Next.js export (some setups track this — see policy)

# --- Python ------------------------------------------------------------
__pycache__/
*.pyc
.venv/
*.egg-info/

# --- Tool caches (regeneratable) ---------------------------------------
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
