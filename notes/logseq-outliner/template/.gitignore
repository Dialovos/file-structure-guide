# Logseq writes auto-backups and version files on every edit.
# These are huge, machine-local, and should never be committed.
logseq/bak/
logseq/version-files/

# The Logseq cache (rebuilt on open).
logseq/.recycle/

# OS junk
.DS_Store
Thumbs.db

